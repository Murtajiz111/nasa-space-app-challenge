# GitHub Linguist language overrides
# Exclude frontend UI files from repository language statistics so Python is 100% dominant
*.ts linguist-detectable=false
*.tsx linguist-detectable=false
*.js linguist-detectable=false
*.mjs linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false
*.json linguist-detectable=false

frontend/** linguist-vendored
frontend/** linguist-detectable=false

# Explicitly ensure backend and ml Python files are detected
backend/**/*.py linguist-detectable=true
ml/**/*.py linguist-detectable=true

# GitHub Linguist language overrides
# Exclude frontend UI and web assets completely from repository language statistics
*.ts -linguist-detectable
*.tsx -linguist-detectable
*.js -linguist-detectable
*.jsx -linguist-detectable
*.mjs -linguist-detectable
*.css -linguist-detectable
*.html -linguist-detectable
*.json -linguist-detectable

frontend/** linguist-vendored
frontend/** -linguist-detectable

# Ensure Python is actively detected and dominant
*.py linguist-detectable
backend/** linguist-detectable
ml/** linguist-detectable
